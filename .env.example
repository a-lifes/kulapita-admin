# ローカルで動かすときだけ .env.local にコピーして使う (本番・dev は ECS の設定で渡す)
# AWS の認証は AWS_PROFILE=kulapita などで行う
AWS_REGION=ap-northeast-1
STAGE=dev
DB_CLUSTER_ARN=arn:aws:rds:ap-northeast-1:560628764056:cluster:kulapita-dev
DB_SECRET_ARN=
# 32 文字以上のランダムな文字列 (openssl rand -hex 32 などで作る)
AUTH_SECRET=
# WAF の IP セット (空なら IP 変更時の WAF 反映をしない)
WAF_IPSET_NAME=
WAF_IPSET_ID=
# ローカル開発のときだけ IP チェックを飛ばす (NODE_ENV=production では無視される)
ADMIN_SKIP_IP_CHECK=1
